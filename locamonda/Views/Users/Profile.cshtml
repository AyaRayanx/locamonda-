@model locamonda.Models.Users
@{
    ViewData["Title"] = "My Profile";
}

<div class="min-h-screen bg-gray-50 flex flex-col md:flex-row pb-10">

  
    <aside class="w-full md:w-72 bg-slate-900 flex flex-col shrink-0">
        <div class="p-8">
            <h2 class="text-2xl font-bold text-white tracking-tight">
                <span class="text-slate-400">Loca</span>Monda
            </h2>
        </div>

        <nav class="flex-1 px-4 space-y-2 mt-4 pb-10">
            @* زر البروفايل  *@
            <a asp-controller="Users" asp-action="Profile" class="flex items-center gap-3 bg-slate-800 text-white px-4 py-3 rounded-2xl transition">
                <i class="fas fa-user-circle"></i>
                <span class="font-medium">My Profile</span>
            </a>

            @if (Model.AccountType == "Owner")
            {
               
                <a asp-controller="Booking" asp-action="OwnerBookings" class="flex items-center gap-3 text-slate-400 hover:bg-slate-800 hover:text-white px-4 py-3 rounded-2xl transition">
                    <i class="fas fa-list-ul"></i>
                    <span>Manage Bookings</span>
                </a>
                
            }
            else
            {
               
                <a asp-controller="Booking" asp-action="Index" class="flex items-center gap-3 text-slate-400 hover:bg-slate-800 hover:text-white px-4 py-3 rounded-2xl transition">
                    <i class="fas fa-calendar-check"></i>
                    <span>My Bookings</span>
                </a>
                <a asp-controller="Favorite" asp-action="Index" class="flex items-center gap-3 text-slate-400 hover:bg-slate-800 hover:text-white px-4 py-3 rounded-2xl transition">
                    <i class="fa-regular fa-heart"></i>
                    <span>Favorites</span>
                </a>
            }

            
        </nav>

        <div class="p-6 border-t border-slate-800">
            <form asp-controller="Users" asp-action="Logout" method="post">
                <button type="submit" class="w-full flex items-center justify-center gap-3 text-red-400 hover:bg-red-500/10 px-4 py-3 rounded-2xl transition">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Logout</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 p-4 md:p-10">

        @* Header Section *@
        <div class="mb-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl font-bold text-slate-900">Account Settings</h1>
                <p class="text-slate-500 mt-1">Manage your personal information and account preferences.</p>
            </div>
            <div class="text-sm font-medium text-slate-400 bg-white px-4 py-2 rounded-xl shadow-sm border border-gray-100">
                Member since @Model.CreatedAt.ToString("MMMM yyyy")
            </div>
        </div>

       
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-1">
                <div class="bg-white p-8 rounded-[2rem] shadow-sm border border-gray-100 flex flex-col items-center text-center">
                    <div class="relative">
                        @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                        {
                            <img src="~/uploads/@Model.ProfilePicture" class="w-32 h-32 rounded-3xl object-cover border-4 border-white shadow-lg" alt="Profile" />
                        }
                        else
                        {
                            <div class="w-32 h-32 bg-slate-100 rounded-3xl flex items-center justify-center text-4xl font-bold text-slate-800 border-4 border-white shadow-inner">
                                @Model.Name.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 mt-5">@Model.Name</h2>
                    <p class="text-slate-500 mt-2 text-sm">@Model.Email</p>
                    <span class="mt-4 px-4 py-2 bg-slate-900 text-white rounded-full text-xs font-bold uppercase tracking-widest">
                        @Model.AccountType
                    </span>
                </div>
            </div>

            <div class="lg:col-span-2">
                <div class="bg-white p-8 md:p-10 rounded-[2rem] shadow-sm border border-gray-100">
                    <h2 class="text-2xl font-bold text-slate-900 mb-8">Edit Profile</h2>
                    <form method="post" asp-action="Profile" enctype="multipart/form-data" class="space-y-6">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="AccountType" />
                        <input type="hidden" asp-for="CreatedAt" />
                        <input type="hidden" asp-for="Email" />
                        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm italic"></div>

                        <div class="space-y-2">
                            <label class="block text-sm font-bold text-slate-700 ml-1">Profile Picture</label>
                            <input type="file" name="profileImage" class="block w-full text-sm text-slate-500
                                file:mr-4 file:py-3 file:px-6
                                file:rounded-2xl file:border-0
                                file:text-sm file:font-bold
                                file:bg-slate-100 file:text-slate-700
                                hover:file:bg-slate-200 transition cursor-pointer bg-gray-50 rounded-2xl p-2"
                                   accept="image/*" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label asp-for="Name" class="block text-sm font-bold text-slate-700 ml-1">Full Name</label>
                                <input asp-for="Name" class="w-full rounded-2xl border-none bg-gray-50 px-5 py-4 focus:ring-2 focus:ring-slate-900 transition outline-none" />
                                <span asp-validation-for="Name" class="text-red-500 text-xs italic"></span>
                            </div>
                            <div class="space-y-2">
                                <label asp-for="Age" class="block text-sm font-bold text-slate-700 ml-1">Age</label>
                                <input asp-for="Age" class="w-full rounded-2xl border-none bg-gray-50 px-5 py-4 focus:ring-2 focus:ring-slate-900 transition outline-none" />
                                <span asp-validation-for="Age" class="text-red-500 text-xs italic"></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label asp-for="PhoneNumber" class="block text-sm font-bold text-slate-700 ml-1">Phone Number</label>
                                <input asp-for="PhoneNumber" class="w-full rounded-2xl border-none bg-gray-50 px-5 py-4 focus:ring-2 focus:ring-slate-900 transition outline-none" />
                                <span asp-validation-for="PhoneNumber" class="text-red-500 text-xs italic"></span>
                            </div>
                            <div class="space-y-2">
                                <label asp-for="Address" class="block text-sm font-bold text-slate-700 ml-1">Address</label>
                                <input asp-for="Address" class="w-full rounded-2xl border-none bg-gray-50 px-5 py-4 focus:ring-2 focus:ring-slate-900 transition outline-none" />
                                <span asp-validation-for="Address" class="text-red-500 text-xs italic"></span>
                            </div>
                        </div>

                        <div class="pt-6 flex flex-col md:flex-row items-center gap-4 border-t border-gray-50">
                            <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white px-10 py-4 rounded-2xl transition font-bold shadow-lg shadow-slate-200 active:scale-95">
                                Save Changes
                            </button>
                            @if (ViewBag.Message != null)
                            {
                                <div class="flex items-center gap-2 text-green-600 font-medium">
                                    <i class="fas fa-check-circle"></i>
                                    <span>@ViewBag.Message</span>
                                </div>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}