@using Microsoft.AspNetCore.Identity
@inject SignInManager<Users> SignInManager
@inject UserManager<Users> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Locamonda</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 text-slate-900">
    <header class="w-full border-b border-gray-200 bg-white shadow-sm sticky top-0 z-50">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
            <div class="flex items-center justify-between">

                <a asp-controller="Home" asp-action="Index" class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                    @* <i class="fa-solid fa-house-chimney text-slate-900"></i> *@
                    <span>Loca<span class="text-slate-700">Monda</span></span>
                </a>

                <div class="hidden md:flex items-center gap-6">
                    <ul class="flex items-center gap-4 text-sm font-medium text-gray-600">
                        <li>
                            <a asp-controller="Home" asp-action="Index" class="hover:text-slate-800 transition">Home</a>
                        </li>
                        @*property View*@
                        <li>
                            <a asp-controller="Property" asp-action="Index" class="hover:text-slate-800 transition">Properties</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            
                                @if (User.IsInRole("Owner"))
                                {
                                <li>
                                    <a asp-controller="Booking" asp-action="OwnerBookings" class="hover:text-slate-800 transition">Manage Booking</a>
                                </li>

                                    <li>
                                    <a asp-controller="Property" asp-action="MyProperties"
                                       class="text-slate-800 font-bold border-l pl-4 border-gray-300 hover:text-slate-600 transition-colors">
                                            Manage My Properties
                                        </a>
                                    </li>
                          
                                }
                                else
                                {
                                    @if (ViewData["HideBooking"] == null || !(bool)ViewData["HideBooking"])
                                    {
                                        <li>
                                            <a asp-controller="Booking" asp-action="Index" asp-route-tab="bookings"
                                            class="hover:text-slate-800 transition font-medium">
                                                My Bookings
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Favorite" asp-action="Index" class="hover:text-slate-800 transition">
                                                Favorites
                                            </a>
                                        </li>
                                    }
                                }
                            

                            @* Favorites تظهر دايماً بره شرط الإخفاء لو حابة *@
                            
                        }
                    </ul>
                    @*User Area*@
                    <div class="flex items-center gap-4 border-l pl-6 border-gray-200">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="relative group">
                                <button class="flex items-center gap-3 text-sm font-bold text-slate-800 hover:text-slate-900 transition">

                                    @* عرض صورة البروفايل أو صورة افتراضية لو مش حاطط صورة *@
                                    @if (currentUser != null && !string.IsNullOrEmpty(currentUser.ProfilePicture))
                                    {
                                        <img src="~/uploads/@currentUser.ProfilePicture"
                                             class="w-8 h-8 rounded-full object-cover border border-gray-200"
                                             alt="Profile">
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-circle-user text-2xl text-gray-400"></i>
                                    }

                                    @* عرض الاسم (Name) بدلاً من الـ UserName/Email *@
                                    <span>@(currentUser?.Name ?? User.Identity?.Name)</span>

                                    <i class="fa-solid fa-chevron-down text-[10px]"></i>
                                </button>

                                <div class="absolute right-0 mt-2 w-48 bg-white border border-gray-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                    <div class="p-2">
                                        @*Profile View*@
                                        <a asp-controller="Users" asp-action="Profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg">My Profile</a>
                                        @*وهنا الNotification عشان لو هنشيلها*@
                                        <a asp-controller="Notification" asp-action="Index" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 rounded-lg">Notifications</a>
                                        <div class="h-px bg-gray-100 my-1"></div>
                                        <form asp-controller="Users" asp-action="Logout" method="post">
                                            <button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50 rounded-lg transition">
                                                Logout
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        @*لو الزاير مش مسجل دخول *@
                        else
                        {

                            <a asp-controller="Users" asp-action="Login" class="text-sm font-medium text-gray-600 hover:text-slate-900">Login</a>
                            <a asp-controller="Users" asp-action="Register" class="bg-slate-800 text-white px-5 py-2 rounded-full text-sm font-medium hover:bg-slate-950 transition shadow-md">
                                Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="min-h-[80vh]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-slate-900 text-gray-300 border-t border-slate-800 mt-10">
        <div class="max-w-7xl mx-auto px-6 py-10">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                <div>
                    <h2 class="text-xl font-bold text-white mb-4">
                        LocaMonda
                    </h2>
                    <p class="text-xs leading-6 text-gray-400 max-w-xs">
                        Redefining your property search experience with exclusive listings and premium opportunities.
                    </p>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                    <div>
                        <h3 class="text-white text-sm font-semibold mb-4 border-b border-slate-700 pb-1 w-fit">Explore</h3>
                        <ul class="space-y-2 text-xs">
                            <li><a asp-controller="Property" asp-action="Index" class="hover:text-white transition">Properties</a></li>
                            <li><a href="#" class="hover:text-white transition">For Sale</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-white text-sm font-semibold mb-4 border-b border-slate-700 pb-1 w-fit">Account</h3>
                        <ul class="space-y-2 text-xs">
                            <li><a asp-controller="Users" asp-action="Profile" class="hover:text-white transition">My Profile</a></li>
                            <li><a asp-controller="Users" asp-action="Register" class="hover:text-white transition">Join Us</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-white text-sm font-semibold mb-4 border-b border-slate-700 pb-1 w-fit">Social</h3>
                        <div class="flex gap-3">
                            <a href="#" class="hover:text-white text-sm"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#" class="hover:text-white text-sm"><i class="fa-brands fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-slate-800 mt-8 pt-4 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] text-gray-500">
                <p>&copy; @DateTime.Now.Year LocasMonda. All rights reserved.</p>
                <p>Designed for LocaMonda Team.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>