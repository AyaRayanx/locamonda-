@model locamonda.Models.Booking
@{
    ViewData["Title"] = "Book Property";
    var property = ViewBag.Property as locamonda.Models.Property;
}

<div class="min-h-screen bg-slate-900 text-white px-6 py-10">
    <div class="max-w-2xl mx-auto bg-slate-800 p-8 rounded-2xl shadow-xl">

        <h1 class="text-3xl font-bold mb-6">Book Property</h1>

        @if (property != null)
        {
            <div class="mb-8 p-4 bg-slate-700/50 rounded-xl border border-slate-600">
                <h2 class="text-xl font-semibold text-white">@property.Title</h2>
                <p class="text-slate-400 mt-1">Price per night: <span class="text-green-400 font-bold">$@property.Price</span></p>
            </div>
        }

        <!-- Error Messages -->
        @if (ViewBag.Error != null)
        {
            <div class="mb-6 p-4 bg-red-500/20 border border-red-500 text-red-100 rounded-xl text-center font-medium">
                <i class="fas fa-exclamation-circle mr-2"></i> @ViewBag.Error
            </div>
        }

        <!-- Success Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 p-4 bg-green-500/20 border border-green-500 text-green-100 rounded-xl text-center font-medium">
                <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                <div class="mt-4">
                    <a asp-action="Index" class="inline-block bg-green-500 text-white px-6 py-2 rounded-lg hover:bg-green-600 transition no-underline">
                        View My Bookings
                    </a>
                </div>
            </div>
        }

        <form asp-action="Create" method="post" class="space-y-6">
            <input type="hidden" asp-for="PropertyId" value="@property?.PropertyId" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block mb-2 text-sm font-medium text-slate-300">Check-in Date</label>
                    <input asp-for="StartDate"
                           required
                           type="date"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           class="w-full p-3 rounded-xl bg-slate-700 border border-slate-600 text-white focus:ring-2 focus:ring-blue-500 outline-none transition" />
                </div>

                <div>
                    <label class="block mb-2 text-sm font-medium text-slate-300">Check-out Date</label>
                    <input asp-for="EndDate"
                           required
                           type="date"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           class="w-full p-3 rounded-xl bg-slate-700 border border-slate-600 text-white focus:ring-2 focus:ring-blue-500 outline-none transition" />
                </div>
            </div>

            <div class="pt-4">
                <button type="submit"
                        class="w-full bg-blue-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-blue-700 shadow-lg transform active:scale-[0.98] transition-all">
                    Confirm Booking Request
                </button>
            </div>
            
            <div class="text-center">
                <a asp-controller="Property" asp-action="Details" asp-route-id="@property?.PropertyId" class="text-slate-400 hover:text-white text-sm transition no-underline">
                    Back to Property Details
                </a>
            </div>
        </form>
    </div>
</div>