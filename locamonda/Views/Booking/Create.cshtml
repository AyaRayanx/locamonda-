@model locamonda.Models.Booking
@{
    ViewData["Title"] = "Book Property";
    var property = ViewBag.Property as locamonda.Models.Property;
}

<div class="min-h-screen bg-gradient-to-b from-slate-950 to-slate-900 text-white px-6 py-12">
    <div class="max-w-2xl mx-auto">

        <!-- Header -->
        <div class="mb-8">
            <a asp-controller="Property" asp-action="Details" asp-route-id="@property?.PropertyId"
               class="inline-flex items-center gap-2 text-slate-400 hover:text-white text-sm transition no-underline mb-4 group">
                <i class="fas fa-arrow-left group-hover:-translate-x-1 transition"></i> Back to Property
            </a>
            <h1 class="text-4xl font-black tracking-tight">Reserve Your Stay</h1>
            <p class="text-slate-400 mt-1">Fill in your dates and confirm your booking request.</p>
        </div>

        <!-- Property Info Card -->
        @if (property != null)
        {
            <div class="mb-8 p-5 bg-white/5 rounded-2xl border border-white/10 flex items-center gap-5">
                @if (property.Photos != null && property.Photos.Any())
                {
                    <img src="@property.Photos.FirstOrDefault()?.PhotoUrl" class="w-20 h-20 rounded-xl object-cover flex-shrink-0" alt="Property">
                }
                else
                {
                    <div class="w-20 h-20 rounded-xl bg-slate-700 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-home text-2xl text-slate-400"></i>
                    </div>
                }
                <div>
                    <h2 class="text-lg font-black text-white">@property.Title</h2>
                    <p class="text-slate-400 text-sm mt-0.5">
                        <i class="fas fa-map-marker-alt text-blue-400 mr-1"></i>
                        @property.Location?.City, @property.Location?.Country
                    </p>
                    <p class="text-emerald-400 font-black text-xl mt-1">
                        $@property.Price <span class="text-slate-400 text-xs font-normal">/ night</span>
                    </p>
                </div>
            </div>
        }

        <!-- Error / Success Messages -->
        @if (ViewBag.Error != null)
        {
            <div class="mb-6 p-4 bg-red-500/20 border border-red-500/50 text-red-200 rounded-2xl flex items-center gap-3">
                <i class="fas fa-exclamation-circle text-red-400 text-xl"></i>
                <span class="font-medium">@ViewBag.Error</span>
            </div>
        }
        @if (TempData["BookingSuccess"] != null)
        {
            <div class="mb-6 p-5 bg-green-500/20 border border-green-500/50 text-green-200 rounded-2xl text-center">
                <i class="fas fa-check-circle text-3xl text-green-400 mb-2 block"></i>
                <p class="font-bold">@TempData["BookingSuccess"]</p>
                <a asp-action="Index" class="inline-block mt-4 bg-green-500 text-white px-6 py-2 rounded-xl hover:bg-green-600 transition no-underline font-bold">
                    View My Bookings
                </a>
            </div>
        }

        <!-- Booking Form -->
        <form asp-action="Create" method="post" class="space-y-6">
            <input type="hidden" asp-for="PropertyId" value="@property?.PropertyId" />

            <div class="bg-white/5 border border-white/10 rounded-3xl p-8 space-y-6">
                <h3 class="text-lg font-black flex items-center gap-2">
                    <i class="fas fa-calendar-alt text-blue-400"></i> Select Your Dates
                </h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block mb-2 text-sm font-bold text-slate-300 uppercase tracking-widest">
                            Check-in
                        </label>
                        <input asp-for="StartDate"
                               id="startDate"
                               required
                               type="date"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               class="w-full p-4 rounded-2xl bg-slate-800 border border-slate-700 text-white focus:ring-2 focus:ring-blue-500 outline-none transition text-lg" />
                    </div>
                    <div>
                        <label class="block mb-2 text-sm font-bold text-slate-300 uppercase tracking-widest">
                            Check-out
                        </label>
                        <input asp-for="EndDate"
                               id="endDate"
                               required
                               type="date"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               class="w-full p-4 rounded-2xl bg-slate-800 border border-slate-700 text-white focus:ring-2 focus:ring-blue-500 outline-none transition text-lg" />
                    </div>
                </div>
            </div>

            <!-- Live Price Summary (hidden until dates are picked) -->
            <div id="priceSummary" class="hidden bg-white/5 border border-white/10 rounded-3xl p-8 space-y-4 transition-all">
                <h3 class="text-lg font-black flex items-center gap-2">
                    <i class="fas fa-receipt text-emerald-400"></i> Price Breakdown
                </h3>
                <div class="space-y-3">
                    <div class="flex justify-between items-center text-slate-300">
                        <span>Price per night</span>
                        <span class="font-bold text-white">$@(property?.Price.ToString("N2"))</span>
                    </div>
                    <div class="flex justify-between items-center text-slate-300">
                        <span>Number of nights</span>
                        <span id="nightsCount" class="font-bold text-white">—</span>
                    </div>
                    <div class="h-px bg-white/10"></div>
                    <div class="flex justify-between items-center text-lg">
                        <span class="font-black text-white">Total Price</span>
                        <span id="totalPrice" class="font-black text-emerald-400 text-2xl">—</span>
                    </div>
                </div>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-5 rounded-2xl font-black text-xl hover:bg-blue-700 shadow-2xl shadow-blue-500/20 transform hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3">
                <i class="fas fa-lock text-base"></i> Confirm Booking Request
            </button>

            <p class="text-center text-xs text-slate-500">
                <i class="fas fa-shield-alt text-blue-500 mr-1"></i>
                Secure booking through Locamonda. Your request will be reviewed by the owner.
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const pricePerNight = @(property?.Price ?? 0);
        const startInput = document.getElementById('startDate');
        const endInput = document.getElementById('endDate');
        const summaryDiv = document.getElementById('priceSummary');
        const nightsEl = document.getElementById('nightsCount');
        const totalEl = document.getElementById('totalPrice');

        function calcPrice() {
            const start = new Date(startInput.value);
            const end = new Date(endInput.value);

            if (!startInput.value || !endInput.value || end <= start) {
                summaryDiv.classList.add('hidden');
                return;
            }

            const nights = Math.round((end - start) / (1000 * 60 * 60 * 24));
            const total = nights * pricePerNight;

            nightsEl.textContent = nights + (nights === 1 ? ' night' : ' nights');
            totalEl.textContent = '$' + total.toLocaleString('en-US', { minimumFractionDigits: 2 });
            summaryDiv.classList.remove('hidden');

            // Ensure checkout is after checkin
            endInput.min = startInput.value;
        }

        startInput.addEventListener('change', calcPrice);
        endInput.addEventListener('change', calcPrice);
    </script>
}