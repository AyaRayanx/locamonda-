@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="relative h-screen w-full overflow-hidden">

    <!-- Background -->
    <div class="absolute inset-0">
        <img src="/images/Home.jpg"
             class="w-full h-full object-cover object-center" />

        <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <!-- Center Content -->
    <div class="relative z-10 flex items-center justify-center h-full text-center px-4">

        <div>

            <h2 class="text-white text-4xl font-extrabold italic mb-6">
                LocaMonda<span class="text-slate-900">.</span>
            </h2>

            <span class="text-white text-sm font-semibold tracking-widest uppercase">
                Find Your Dream Home
            </span>

            <h1 class="text-white text-5xl md:text-7xl font-bold mt-4 mb-10">
                Discover Best Unit
            </h1>

            <!-- Search -->
            <form method="get" asp-controller="Property" asp-action="Index"
                  class="bg-white/95 rounded-2xl shadow-2xl p-6 md:p-8 w-full max-w-5xl mx-auto">

                <div class="grid grid-cols-1 md:grid-cols-5 gap-4">

                    <input type="text" name="city" placeholder="City"
                           class="border rounded-lg px-4 py-3 text-sm" />

                    <input type="number" name="minPrice" placeholder="Min Price"
                           class="border rounded-lg px-4 py-3 text-sm" />

                    <input type="number" name="maxPrice" placeholder="Max Price"
                           class="border rounded-lg px-4 py-3 text-sm" />

                    <select name="categoryId"
                            asp-items="ViewBag.Categories"
                            class="border rounded-lg px-4 py-3 text-sm bg-white">
                        <option value="">All Categories</option>
                    </select>

                    <button type="submit"
                            class="bg-slate-900 text-white rounded-lg py-3 hover:bg-black transition">
                        SEARCH
                    </button>

                </div>
            </form>

        </div>

    </div>
</div>