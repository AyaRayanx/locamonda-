@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<div class="relative h-screen w-full overflow-hidden">

    <!-- Background -->
    <div class="absolute inset-0">
        <img src="/images/Home.jpg"
             class="w-full h-full object-cover object-center" />

        <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <!-- Center Content -->
    <div class="relative z-10 flex items-center justify-center h-full text-center px-4">

        <div>

            <h2 class="text-white text-4xl font-extrabold italic mb-6">
                LocaMonda<span class="text-slate-900">.</span>
            </h2>

            <span class="text-white text-sm font-semibold tracking-widest uppercase">
                Find Your Dream Home
            </span>

            <h1 class="text-white text-5xl md:text-7xl font-bold mt-4 mb-10">
                Discover Best Unit
            </h1>

            <!-- Search -->
            <!-- Search -->
            <form method="get" asp-controller="Property" asp-action="Index"
                  class="bg-white/95 backdrop-blur-md rounded-[2.5rem] shadow-2xl p-8 md:p-10 w-full max-w-5xl mx-auto border border-white/20 transform hover:scale-[1.01] transition-all duration-500">
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 items-end">
                    
                    <div class="flex flex-col gap-2 text-left">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-2">Location</label>
                        <input type="text" name="city" placeholder="Which city?"
                               class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl text-slate-900 font-bold placeholder:text-slate-300 focus:ring-2 focus:ring-slate-900/5 transition-all outline-none shadow-inner" />
                    </div>

                    <div class="flex flex-col gap-2 text-left">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-2">Min Price</label>
                        <input type="number" name="minPrice" placeholder="0 EGP"
                               class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl text-slate-900 font-bold placeholder:text-slate-300 focus:ring-2 focus:ring-slate-900/5 transition-all outline-none shadow-inner" />
                    </div>

                    <div class="flex flex-col gap-2 text-left">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-2">Max Price</label>
                        <input type="number" name="maxPrice" placeholder="Any"
                               class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl text-slate-900 font-bold placeholder:text-slate-300 focus:ring-2 focus:ring-slate-900/5 transition-all outline-none shadow-inner" />
                    </div>

                    <div class="flex flex-col gap-2 text-left">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-2">Property Type</label>
                        <select name="categoryId"
                                asp-items="ViewBag.Categories"
                                class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl text-slate-900 font-bold focus:ring-2 focus:ring-slate-900/5 transition-all outline-none appearance-none cursor-pointer shadow-inner">
                            <option value="">All Types</option>
                        </select>
                    </div>

                    <button type="submit"
                            class="w-full bg-slate-900 text-white font-black py-4 rounded-2xl hover:bg-black transition-all duration-300 shadow-xl shadow-slate-900/20 text-sm tracking-widest uppercase active:scale-95 flex items-center justify-center gap-2">
                        Search
                    </button>

                </div>
            </form>

        </div>

    </div>
</div>