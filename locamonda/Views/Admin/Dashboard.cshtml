@using locamonda.Models
@{
    ViewData["Title"] = "Admin Dashboard";
    var recentReports = ViewBag.RecentReports as List<Report> ?? new List<Report>();
    var recentProperties = ViewBag.RecentPendingProperties as List<Property> ?? new List<Property>();
}

<div class="py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Page Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4">
            <div>
                <h1 class="text-3xl font-black text-slate-900 tracking-tight">Administrative Dashboard</h1>
                <p class="text-slate-500 mt-1 text-sm">Manage users, moderate listings, and resolve reports.</p>
            </div>
            <div class="flex items-center gap-2 bg-white px-5 py-2.5 rounded-2xl shadow-sm border border-slate-100">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-sm font-semibold text-slate-600">System Online</span>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-all group">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition">
                        <i class="fas fa-users text-blue-600 text-xl"></i>
                    </div>
                </div>
                <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Total Users</p>
                <p class="text-4xl font-black text-slate-900">@ViewBag.TotalUsers</p>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-all group">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition">
                        <i class="fas fa-home text-emerald-600 text-xl"></i>
                    </div>
                </div>
                <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">Total Properties</p>
                <p class="text-4xl font-black text-slate-900">@ViewBag.TotalProperties</p>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border-2 border-amber-200 hover:shadow-md transition-all group ring-1 ring-amber-100">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition">
                        <i class="fas fa-clock text-amber-500 text-xl"></i>
                    </div>
                    <span class="text-[10px] bg-amber-100 text-amber-700 px-2 py-1 rounded-full font-black uppercase tracking-wider">Pending</span>
                </div>
                <p class="text-amber-600 text-xs font-bold uppercase tracking-widest mb-1">Awaiting Approval</p>
                <p class="text-4xl font-black text-amber-600">@ViewBag.PendingPropertiesCount</p>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border-2 border-rose-200 hover:shadow-md transition-all group ring-1 ring-rose-100">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-rose-50 rounded-2xl flex items-center justify-center group-hover:scale-110 transition">
                        <i class="fas fa-flag text-rose-500 text-xl"></i>
                    </div>
                    <span class="text-[10px] bg-rose-100 text-rose-700 px-2 py-1 rounded-full font-black uppercase tracking-wider">Urgent</span>
                </div>
                <p class="text-rose-600 text-xs font-bold uppercase tracking-widest mb-1">Active Reports</p>
                <p class="text-4xl font-black text-rose-600">@ViewBag.ActiveReportsCount</p>
            </div>
        </div>

        <!-- Quick Action Cards -->
        <h2 class="text-lg font-black text-slate-700 uppercase tracking-widest mb-5">Quick Actions</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <a asp-action="Users" class="group bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:border-blue-400 hover:shadow-xl transition-all no-underline flex items-start gap-5">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-blue-100 transition">
                    <i class="fas fa-user-shield text-blue-600 text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 mb-1">User Management</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Review, block, or restore user accounts.</p>
                    <span class="inline-flex items-center gap-1 mt-3 text-blue-600 text-xs font-bold">Manage Users <i class="fas fa-arrow-right text-[10px]"></i></span>
                </div>
            </a>

            <a asp-action="Properties" class="group bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:border-emerald-400 hover:shadow-xl transition-all no-underline flex items-start gap-5">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-emerald-100 transition">
                    <i class="fas fa-clipboard-check text-emerald-600 text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 mb-1">Property Moderation</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Approve or reject new property listings.</p>
                    <span class="inline-flex items-center gap-1 mt-3 text-emerald-600 text-xs font-bold">Review Queue <i class="fas fa-arrow-right text-[10px]"></i></span>
                </div>
            </a>

            <a asp-action="Reports" class="group bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:border-rose-400 hover:shadow-xl transition-all no-underline flex items-start gap-5">
                <div class="w-14 h-14 rounded-2xl bg-rose-50 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-rose-100 transition">
                    <i class="fas fa-exclamation-triangle text-rose-600 text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-black text-slate-900 mb-1">Resolution Center</h3>
                    <p class="text-slate-400 text-sm leading-relaxed">Handle community reports and investigations.</p>
                    <span class="inline-flex items-center gap-1 mt-3 text-rose-600 text-xs font-bold">View Reports <i class="fas fa-arrow-right text-[10px]"></i></span>
                </div>
            </a>
        </div>

        <!-- Recent Activity -->
        <h2 class="text-lg font-black text-slate-700 uppercase tracking-widest mb-5">Recent Activity</h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

            <!-- Recent Reports -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-rose-50 rounded-xl flex items-center justify-center">
                            <i class="fas fa-flag text-rose-500 text-sm"></i>
                        </div>
                        <h3 class="font-black text-slate-900">Recent Incident Reports</h3>
                    </div>
                    <a asp-action="Reports" class="text-[10px] font-black text-rose-600 hover:text-rose-800 transition uppercase tracking-wider bg-rose-50 px-3 py-1.5 rounded-xl">View All</a>
                </div>
                <div class="divide-y divide-slate-50">
                    @if (recentReports.Any())
                    {
                        @foreach (var report in recentReports)
                        {
                            <div class="p-5 hover:bg-slate-50 transition">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="text-[10px] font-black px-3 py-1 rounded-full
                                        @(report.Status == "Pending" ? "bg-amber-50 text-amber-600 border border-amber-100" : "bg-emerald-50 text-emerald-600 border border-emerald-100")">
                                        @report.Status
                                    </span>
                                    <span class="text-[10px] text-slate-400 font-medium">@report.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <p class="text-sm text-slate-700 font-bold mb-1 line-clamp-1">@report.Reason</p>
                                <p class="text-[11px] text-slate-400">
                                    Reported by: <a asp-controller="Users" asp-action="Details" asp-route-id="@report.ReporterId" class="font-bold text-blue-600 hover:underline">@report.Reporter?.Name</a>
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-12 text-center">
                            <i class="fas fa-check-circle text-3xl text-slate-200 mb-3 block"></i>
                            <p class="text-slate-400 text-sm font-medium">No active reports. All clear!</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Pending Properties -->
            <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-amber-50 rounded-xl flex items-center justify-center">
                            <i class="fas fa-clock text-amber-500 text-sm"></i>
                        </div>
                        <h3 class="font-black text-slate-900">Pending Property Reviews</h3>
                    </div>
                    <a asp-action="Properties" class="text-[10px] font-black text-emerald-600 hover:text-emerald-800 transition uppercase tracking-wider bg-emerald-50 px-3 py-1.5 rounded-xl">Review Queue</a>
                </div>
                <div class="divide-y divide-slate-50">
                    @if (recentProperties.Any())
                    {
                        @foreach (var property in recentProperties)
                        {
                            <div class="p-5 hover:bg-slate-50 transition">
                                <div class="flex justify-between items-start gap-4">
                                    <div class="min-w-0">
                                        <h4 class="text-sm font-black text-slate-900 mb-1 truncate">@property.Title</h4>
                                        <p class="text-[11px] text-slate-400">
                                            Owner: <a asp-controller="Users" asp-action="Details" asp-route-id="@property.OwnerId" class="font-bold text-blue-600 hover:underline">@property.Owner?.Name</a>
                                            <span class="mx-1">•</span> @property.DateAdded.ToString("MMM dd")
                                        </p>
                                        <p class="text-[11px] text-slate-400 mt-0.5">
                                            <i class="fas fa-map-marker-alt text-rose-400 mr-1"></i>@property.Location?.City, @property.Location?.Country
                                        </p>
                                    </div>
                                    <div class="flex gap-2 flex-shrink-0">
                                        <form asp-action="ApproveProperty" asp-route-id="@property.PropertyId" method="post">
                                            <button type="submit" title="Approve" class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 hover:bg-emerald-100 transition border border-emerald-100 flex items-center justify-center">
                                                <i class="fas fa-check text-xs"></i>
                                            </button>
                                        </form>
                                        <a asp-controller="Property" asp-action="Details" asp-route-id="@property.PropertyId" title="View" class="w-9 h-9 rounded-xl bg-slate-50 text-slate-600 hover:bg-slate-100 transition border border-slate-100 flex items-center justify-center no-underline">
                                            <i class="fas fa-eye text-xs"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-12 text-center">
                            <i class="fas fa-inbox text-3xl text-slate-200 mb-3 block"></i>
                            <p class="text-slate-400 text-sm font-medium">Queue is empty. Nothing to review!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
