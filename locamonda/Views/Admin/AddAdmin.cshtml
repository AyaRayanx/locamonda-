@model locamonda.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Add New Admin";
}

<div class="min-h-screen bg-slate-50 py-16 px-4">
    <div class="max-w-2xl mx-auto">
        <div class="flex items-center gap-4 mb-10">
            <a asp-action="Users" class="bg-white p-3 rounded-2xl shadow-sm border border-slate-100 hover:bg-slate-50 transition text-slate-600 no-underline">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Create Admin Account</h1>
                <p class="text-sm text-slate-500">Add a new administrator to the platform.</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl p-10 shadow-xl border border-slate-100">
            <form asp-action="AddAdmin" method="post" class="space-y-6">
                <div asp-validation-summary="All" class="p-4 bg-rose-50 text-rose-600 rounded-2xl text-sm font-bold border border-rose-100"></div>
                <input type="hidden" name="AccountType" value="Admin" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Full Name</label>
                        <input asp-for="Name" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="Admin Name" />
                        <span asp-validation-for="Name" class="text-rose-500 text-[10px] font-bold mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Phone Number</label>
                        <input asp-for="PhoneNumber" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="01xxxxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="text-rose-500 text-[10px] font-bold mt-1"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Email Address</label>
                    <input asp-for="Email" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="admin@example.com" />
                    <span asp-validation-for="Email" class="text-rose-500 text-[10px] font-bold mt-1"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Address</label>
                        <input asp-for="Address" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="City, Street" />
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Age</label>
                        <input asp-for="Age" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="30" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Password</label>
                        <input asp-for="Password" type="password" autocomplete="new-password" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-rose-500 text-[10px] font-bold mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl outline-none focus:ring-2 focus:ring-slate-900/10 transition" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-rose-500 text-[10px] font-bold mt-1"></span>
                    </div>
                </div>

                <div class="pt-6">
                    <button type="submit" class="w-full bg-slate-900 text-white py-4 rounded-2xl font-bold text-lg hover:bg-slate-800 transition shadow-xl transform hover:-translate-y-0.5 active:translate-y-0 duration-200">
                        Create Admin Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
