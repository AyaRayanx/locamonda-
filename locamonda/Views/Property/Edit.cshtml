@model locamonda.Models.Property

@{
    ViewData["Title"] = "Edit Property";
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="min-h-screen bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto">
        <h1 class="text-[32px] font-black text-[#1A2B49] mb-12">Edit Property</h1>

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="space-y-8">
            <input type="hidden" asp-for="PropertyId" />

            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-black text-[#1A2B49] mb-2">Title</label>
                    <input asp-for="Title" class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none" placeholder="Property Title" />
                </div>

                <div>
                    <label class="block text-sm font-black text-[#1A2B49] mb-2">Description</label>
                    <textarea asp-for="Description" rows="4" class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none" placeholder="Description"></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-black text-[#1A2B49] mb-2">Location / City</label>
                        <input list="locationList" name="LocationName" id="LocationNameInput" 
                               value="@Model.Location?.City"
                               class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none focus:ring-2 focus:ring-[#1A2B49]/10" 
                               placeholder="Type or select city..." />
                        <datalist id="locationList">
                            @foreach (var item in (SelectList)ViewBag.Locations)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        </datalist>
                    </div>

                    <div>
                        <label class="block text-sm font-black text-[#1A2B49] mb-2">Property Type</label>
                        <input list="categoryList" name="CategoryName" 
                               value="@Model.Category?.Name"
                               class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none focus:ring-2 focus:ring-[#1A2B49]/10" 
                               placeholder="Type or select type..." />
                        <datalist id="categoryList">
                            @foreach (var item in (SelectList)ViewBag.Categories)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        </datalist>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="block text-sm font-black text-[#1A2B49] mb-2">Price (EGP)</label>
                        <input asp-for="Price" class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-black text-[#1A2B49] mb-2">Rooms</label>
                        <input asp-for="Rooms" class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none" />
                    </div>
                    <div>
                        <label class="block text-sm font-black text-[#1A2B49] mb-2">Bathrooms</label>
                        <input asp-for="Bathrooms" class="w-full px-6 py-4 bg-[#F8FAFC] rounded-2xl outline-none" />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label asp-for="Status" class="block text-sm font-black text-[#1A2B49] mb-2">Availability Status</label>
                    <div class="relative">
                        <select asp-for="Status" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl font-bold text-[#1A2B49] outline-none appearance-none cursor-pointer focus:ring-2 focus:ring-[#1A2B49]/10">
                            <option value="Available">Available</option>
                            <option value="Rented">Rented</option>
                            <option value="Maintenance">Maintenance</option>
                        </select>
                        <i class="fas fa-chevron-down absolute right-6 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-xs"></i>
                    </div>
                </div>

                <!-- Location Map Removed -->
                <input type="hidden" asp-for="Latitude" id="Latitude" />
                <input type="hidden" asp-for="Longitude" id="Longitude" />

                <div class="space-y-4 pt-6 border-t border-slate-100">
                    <label class="block text-sm font-black text-[#1A2B49]">Current Photos</label>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        @if (Model.Photos != null && Model.Photos.Any())
                        {
                            foreach (var photo in Model.Photos)
                            {
                                <div class="relative h-32 rounded-2xl overflow-hidden border border-slate-100 shadow-sm">
                                    <img src="@photo.PhotoUrl"
                                         class="w-full h-full object-cover"
                                         alt="Property Photo" />
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-slate-400 text-xs italic">No photos uploaded yet.</p>
                        }
                    </div>
                </div>

                <div class="flex flex-col gap-4 mt-8">
                    <label class="text-sm font-black text-[#1A2B49]">Upload New Photos (Optional)</label>
                    <div class="relative">
                        <label for="imageFiles" class="flex flex-col items-center justify-center w-full h-32 bg-[#F8FAFC] border-2 border-dashed border-slate-200 rounded-3xl cursor-pointer hover:bg-slate-50 transition-all">
                            <i class="fas fa-cloud-upload-alt text-[#1A2B49]/40 text-2xl mb-2"></i>
                            <p class="text-xs text-slate-500 font-bold">Add more photos</p>
                            <input type="file" name="imageFiles" id="imageFiles" multiple class="hidden" accept="image/*" onchange="previewImages()" />
                        </label>
                    </div>
                    <div id="image-preview-container" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-2"></div>
                </div>
            </div>

            <div class="flex gap-4 pt-8 border-t border-slate-100">
                <button type="submit" class="flex-1 bg-[#1A2B49] text-white py-4 rounded-2xl font-bold text-lg hover:opacity-90 transition-all shadow-lg">
                    Save Changes
                </button>
                <a asp-action="MyProperties" class="px-10 py-4 bg-[#F1F5F9] text-[#1A2B49] rounded-2xl font-bold no-underline hover:bg-slate-200 transition-all text-center">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function previewImages() {
            const container = document.getElementById('image-preview-container');
            const files = document.getElementById('imageFiles').files;
            container.innerHTML = '';

            if (files) {
                Array.from(files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const div = document.createElement('div');
                        div.className = "relative h-32 w-full overflow-hidden rounded-2xl shadow-sm border border-slate-100";
                        div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover" />`;
                        container.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                });
            }
        }
    </script>
}