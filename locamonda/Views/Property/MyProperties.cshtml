@model IEnumerable<locamonda.Models.Property>

@{
    ViewData["Title"] = "Manage My Properties";
}

<!-- ضمان عمل تيلويند -->
<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">

        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
            <div>
                <h1 class="text-[32px] font-black text-[#1A2B49] leading-tight">Manage My Properties</h1>
                <p class="text-slate-500 font-medium text-sm mt-2">Manage your listings and property details on Locamonda.</p>
            </div>
            <a asp-controller="Property" asp-action="Create" class="inline-flex items-center px-8 py-4 text-base font-bold rounded-2xl text-white bg-[#1A2B49] hover:opacity-90 transition-all shadow-lg shadow-blue-900/10 no-underline">
                <i class="fas fa-plus mr-2 text-xs"></i> Add New Property
            </a>
        </div>

        <!-- Table Container -->
        <div class="bg-white rounded-[2rem] overflow-hidden border border-slate-100 shadow-[0_10px_40px_rgba(0,0,0,0.03)]">
            <div class="overflow-x-auto">
                <table class="min-w-full border-collapse">
                    <thead>
                        <tr class="bg-[#F8FAFC]">
                            <th class="px-8 py-5 text-left text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Property Details</th>
                            <th class="px-6 py-5 text-center text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Category</th>
                            <th class="px-6 py-5 text-center text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Location</th>
                            <th class="px-6 py-5 text-center text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Price</th>
                            <th class="px-6 py-5 text-center text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Status</th>
                            <th class="px-6 py-5 text-center text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Admin Approval</th>
                            <th class="px-8 py-5 text-right text-[11px] font-black text-[#1A2B49] uppercase tracking-[0.1em]">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-[#F8FAFC]/50 transition-colors">
                                <td class="px-8 py-6 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="h-16 w-16 flex-shrink-0 bg-slate-100 rounded-2xl overflow-hidden border border-slate-50">
                                            @{
                                                var photo = item.Photos?.FirstOrDefault(p => p.IsMain) ?? item.Photos?.FirstOrDefault();
                                                var photoUrl = photo?.PhotoUrl;
                                                var displayPhoto = !string.IsNullOrEmpty(photoUrl)
                                                ? (photoUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? photoUrl : (photoUrl.StartsWith("/") ? photoUrl : "/uploads/" + photoUrl))
                                                : "/images/placeholder.jpg";
                                            }
                                            <img src="@displayPhoto" class="h-full w-full object-cover" alt="Property">
                                        </div>
                                        <div class="ml-5">
                                            <div class="text-base font-black text-[#1A2B49]">@item.Title</div>
                                            <div class="text-[11px] text-slate-400 font-bold mt-1">ID: #@item.PropertyId.ToString().PadLeft(4, '0')</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    <span class="text-sm text-slate-600 font-bold bg-slate-50 px-4 py-2 rounded-xl">@item.Category?.Name</span>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    <div class="text-sm text-[#1A2B49] font-bold">
                                        <i class="fas fa-map-marker-alt text-slate-300 mr-1.5"></i> @item.Location?.City
                                    </div>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    <div class="text-sm font-black text-[#1A2B49]">EGP @item.Price.ToString("N0")</div>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    @{
                                        var statusClass = item.Status == "Available" ? "bg-emerald-50 text-emerald-600" : "bg-amber-50 text-amber-600";
                                    }
                                    <span class="px-4 py-1.5 inline-flex text-[10px] font-black uppercase tracking-wider rounded-full @statusClass">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="px-6 py-6 whitespace-nowrap text-center">
                                    @if (item.IsApproved)
                                    {
                                        <span class="px-4 py-1.5 inline-flex text-[10px] font-black uppercase tracking-wider rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100">
                                            <i class="fas fa-check-circle mr-1"></i> Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-4 py-1.5 inline-flex text-[10px] font-black uppercase tracking-wider rounded-full bg-amber-50 text-amber-600 border border-amber-100">
                                            <i class="fas fa-clock mr-1"></i> Pending Review
                                        </span>
                                    }
                                </td>
                                <td class="px-8 py-6 whitespace-nowrap text-right text-sm">
                                    <div class="flex justify-end items-center gap-3">
                                        <!-- زر التعديل: يوجه لصفحة الـ Edit -->
                                        <a asp-action="Edit" asp-route-id="@item.PropertyId" class="px-4 py-2 bg-[#F1F5F9] text-[#1A2B49] font-bold rounded-xl hover:bg-[#1A2B49] hover:text-white transition-all text-xs no-underline">
                                            <i class="fas fa-edit mr-1"></i> Edit
                                        </a>

                                        <!-- زر الحذف: كلمة واضحة بدلاً من أيقونة الزبالة فقط -->
                                        <a asp-action="Delete" asp-route-id="@item.PropertyId"
                                           onclick="return confirm('Are you sure you want to delete this property?')"
                                           class="px-4 py-2 bg-red-50 text-red-500 font-bold rounded-xl hover:bg-red-500 hover:text-white transition-all text-xs no-underline">
                                            <i class="fas fa-trash-alt mr-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="py-24 text-center">
                    <div class="w-20 h-20 bg-slate-50 text-slate-200 rounded-[2rem] flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-building text-3xl"></i>
                    </div>
                    <h3 class="text-lg font-black text-[#1A2B49]">No properties yet</h3>
                    <p class="text-slate-400 text-sm mt-2">Start by adding your first property listing.</p>
                </div>
            }
        </div>
    </div>
</div>