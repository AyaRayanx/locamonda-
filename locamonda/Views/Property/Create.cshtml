@model locamonda.Models.Property

@{
    ViewData["Title"] = "Add New Property";
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="min-h-screen bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto">

        <div class="mb-12">
            <h1 class="text-[32px] font-black text-[#1A2B49] leading-tight">List New Property</h1>
            <p class="text-slate-500 font-medium text-sm mt-2">Fill in the details and upload high-quality photos.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="space-y-8">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-bold p-4 bg-red-50 rounded-2xl mb-6"></div>

            <div class="space-y-6">
                <!-- Title -->
                <div class="flex flex-col gap-2">
                    <label asp-for="Title" class="text-sm font-black text-[#1A2B49]">Property Title</label>
                    <input asp-for="Title" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl focus:ring-2 focus:ring-[#1A2B49]/10 font-medium text-[#1A2B49] outline-none transition-all"
                           placeholder="e.g. Modern 2-Bedroom Apartment with Nile View" />
                    <span asp-validation-for="Title" class="text-red-500 text-xs"></span>
                </div>

                <!-- Description -->
                <div class="flex flex-col gap-2">
                    <label asp-for="Description" class="text-sm font-black text-[#1A2B49]">Description</label>
                    <textarea asp-for="Description" rows="4" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl focus:ring-2 focus:ring-[#1A2B49]/10 font-medium text-[#1A2B49] outline-none transition-all"
                              placeholder=" Describe your property (e.g. amenities, nearby landmarks, floor number, etc.)"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-xs"></span>
                </div>

                <!-- Photos -->
                <div class="flex flex-col gap-4">
                    <label class="text-sm font-black text-[#1A2B49]">Property Photos</label>
                    <div class="relative">
                        <label for="imageFiles" class="flex flex-col items-center justify-center w-full h-40 bg-[#F8FAFC] border-2 border-dashed border-slate-200 rounded-3xl cursor-pointer hover:bg-slate-50 hover:border-[#1A2B49]/20 transition-all">
                            <i class="fas fa-images text-[#1A2B49]/40 text-3xl mb-2"></i>
                            <p class="text-sm text-slate-500 font-bold">Click to add photos</p>
                            <input type="file" name="imageFiles" id="imageFiles" multiple class="hidden" accept="image/*" onchange="previewImages()" />
                        </label>
                    </div>
                    <div id="image-preview-container" class="grid grid-cols-2 md:grid-cols-3 gap-4 mt-2"></div>
                </div>

                <!-- Specs Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="flex flex-col gap-2">
                        <label asp-for="Price" class="text-sm font-black text-[#1A2B49]">Price (EGP)</label>
                        <input asp-for="Price" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl font-black text-[#1A2B49] outline-none" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label asp-for="Rooms" class="text-sm font-black text-[#1A2B49]">Rooms</label>
                        <input asp-for="Rooms" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl font-bold text-[#1A2B49] outline-none" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label asp-for="Bathrooms" class="text-sm font-black text-[#1A2B49]">Bathrooms</label>
                        <input asp-for="Bathrooms" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl font-bold text-[#1A2B49] outline-none" />
                    </div>
                </div>

                <!-- Hybrid Inputs (Location & Category) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Location / City -->
                    <div class="flex flex-col gap-2">
                        <label class="text-sm font-black text-[#1A2B49]">Location / City (Select or Type)</label>
                        <input list="locationList" name="LocationName" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl font-bold text-[#1A2B49] outline-none focus:ring-2 focus:ring-[#1A2B49]/10" placeholder="Type or select city..." />
                        <datalist id="locationList">
                            @foreach (var item in (SelectList)ViewBag.Locations)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        </datalist>
                    </div>

                    <!-- Property Type / Category -->
                    <div class="flex flex-col gap-2">
                        <label class="text-sm font-black text-[#1A2B49]">Property Type (Select or Type)</label>
                        <input list="categoryList" name="CategoryName" class="w-full px-6 py-4 bg-[#F8FAFC] border-none rounded-2xl font-bold text-[#1A2B49] outline-none focus:ring-2 focus:ring-[#1A2B49]/10" placeholder="Type or select type..." />
                        <datalist id="categoryList">
                            @foreach (var item in (SelectList)ViewBag.Categories)
                            {
                                <option value="@item.Text">@item.Text</option>
                            }
                        </datalist>
                    </div>
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex items-center gap-4 pt-8 border-t border-slate-100 mt-10">
                <button type="submit" class="flex-1 bg-[#1A2B49] text-white py-4 rounded-2xl font-bold text-lg hover:opacity-95 shadow-xl transition-all">
                    Create Listing
                </button>
                <a asp-action="MyProperties" class="px-10 py-4 bg-[#F1F5F9] text-[#1A2B49] rounded-2xl font-bold text-center no-underline hover:bg-slate-200">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    function previewImages() {
    const container = document.getElementById('image-preview-container');
    const files = document.getElementById('imageFiles').files;
    container.innerHTML = '';

    if (files) {
    Array.from(files).forEach(file => {
    const reader = new FileReader();
    reader.onload = (e) => {
    const div = document.createElement('div');
    div.className = "relative h-40 w-full overflow-hidden rounded-2xl shadow-sm border border-slate-100";
    div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover" />`;
    container.appendChild(div);
    };
    reader.readAsDataURL(file);
    });
    }
    }
</script>