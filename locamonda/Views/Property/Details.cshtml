@* @model locamonda.Models.Property

<div class="min-h-screen bg-slate-900 text-white px-6 py-10">

    <div class="max-w-5xl mx-auto">

        <!-- Title -->
        <h1 class="text-3xl md:text-4xl font-bold mb-4">
            @Model.Title
        </h1>

        <!-- Location -->
        <p class="text-slate-400 mb-6">
            📍 @Model.Location?.City
        </p>

        <!-- Image -->
        <div class="rounded-2xl overflow-hidden mb-8">
            @* <img src="@(Model.Photos.FirstOrDefault()?.ImageUrl ?? "/images/default.jpg")" *@
@*                  class="w-full h-96 object-cover" />
        </div>

        <!-- Info -->
        <div class="bg-slate-800 rounded-2xl p-6 mb-8 shadow-lg">

            <p class="text-lg mb-2">
                💰 Price:
                <span class="text-white font-bold">$@Model.Price</span>
            </p>

            <p class="text-slate-300">
                🛏 Rooms: @Model.Rooms | 🛁 Bathrooms: @Model.Bathrooms
            </p>

            <p class="mt-4 text-slate-300">
                @Model.Description
            </p>

        </div>

        <!-- Reviews -->
        <div class="bg-slate-800 rounded-2xl p-6 mb-8">

            <h2 class="text-xl font-bold mb-4">Reviews</h2>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                @foreach (var r in Model.Reviews)
                {
                    <div class="border-b border-slate-700 py-4">

                        <!-- Stars -->
                        <div class="flex gap-1 mb-2">
                            @for (int i = 0; i < r.Rating; i++)
                            {
                                <span>⭐</span>
                            }
                        </div>

                        <!-- Comment -->
                        <p class="text-slate-200">
                            @r.Comment
                        </p>

                    </div>
                }
            }
            else
            {
                <p class="text-slate-400">No reviews yet</p>
            }

        </div>

        <!-- Add Review -->
        <div class="bg-slate-800 rounded-2xl p-6 mb-8">

            <h2 class="text-xl font-bold mb-4">Add Your Review</h2>

            <form asp-controller="Review" asp-action="Create" method="post" class="space-y-4">

                <!-- Property Id -->
                <input type="hidden" name="PropertyId" value="@Model.PropertyId" />

                <!-- Comment -->
                <textarea name="Comment"
                          class="w-full p-3 rounded-lg bg-slate-900 text-white border border-slate-700 focus:ring-2 focus:ring-slate-600"
                          placeholder="Write your review..."></textarea>

             <!-- Rating -->
<div class="rating flex flex-row-reverse justify-end gap-1">

    <input type="radio" name="Rating" id="star5" value="5">
    <label for="star5">★</label>

    <input type="radio" name="Rating" id="star4" value="4">
    <label for="star4">★</label>

    <input type="radio" name="Rating" id="star3" value="3">
    <label for="star3">★</label>

    <input type="radio" name="Rating" id="star2" value="2">
    <label for="star2">★</label>

    <input type="radio" name="Rating" id="star1" value="1">
    <label for="star1">★</label>

</div>

<style>
    .rating input {
        display: none;
    }

    .rating label {
        font-size: 35px;
        color: #475569; /* slate */
        cursor: pointer;
        transition: 0.3s;
    }

    /* hover */
    .rating label:hover,
    .rating label:hover ~ label {
        color: #facc15;
    }

    /* selected */
    .rating input:checked ~ label {
        color: #facc15;
    }
</style>
                <!-- Button -->
                <button type="submit"
                        class="bg-slate-700 hover:bg-slate-600 px-4 py-2 rounded-lg font-bold transition">
                    Submit Review
                </button>

            </form>

        </div>

        <!-- Contact Owner -->
       <a asp-controller="Message"
   asp-action="Send"
   asp-route-propertyId="@Model.PropertyId"
   class="bg-slate-800 hover:bg-slate-700 px-4 py-2 rounded-lg">
   Contact Owner
</a>

    </div>
</div> *@


