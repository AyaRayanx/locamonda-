@model locamonda.Models.Property
@inject Microsoft.AspNetCore.Identity.UserManager<Users> UserManager
@{
    ViewData["Title"] = Model.Title;
    var user = await UserManager.GetUserAsync(User);
    bool isOwner = user != null && Model.OwnerId == user.Id;
}

<div class="min-h-screen bg-gradient-to-b from-slate-950 to-slate-900 px-6 py-10 text-white">
    <div class="max-w-5xl mx-auto space-y-8">

        <!-- Title + Location -->
        <div class="space-y-4">
            <div>
                <div class="flex justify-between items-start">
                    <h1 class="text-4xl font-bold tracking-wide text-white">@Model.Title</h1>
                    
                    @if (user != null && !isOwner && !User.IsInRole("Admin") && !User.IsInRole("Owner"))
                    {
                        <!-- Favorite Heart Icon -->
                        <form asp-controller="Favorite" asp-action="Add" asp-route-propertyId="@Model.PropertyId" method="post">
                            <button type="submit" class="text-3xl hover:scale-110 transition duration-300">
                                @(ViewBag.IsFavorite == true ? "❤️" : "🤍")
                            </button>
                        </form>
                    }
                </div>
                <p class="text-slate-400 mt-2 text-lg italic">✨ Discover your next home away from home</p>
            </div>

            <!-- Owner Contact Box -->
            <div class="bg-white/10 border border-white/10 backdrop-blur-md rounded-2xl p-4 flex items-center gap-4 shadow-lg">
                <div class="bg-slate-800 p-3 rounded-xl text-2xl">👤</div>
                <div class="flex-1">
                    <div class="flex justify-between items-center mb-2">
                        <p class="text-sm text-slate-400">Listed by</p>
                        @if (user != null && !isOwner)
                        {
                            <a asp-controller="Report" asp-action="Create" asp-route-propertyId="@Model.PropertyId" asp-route-userId="@Model.OwnerId"
                               class="text-[10px] uppercase font-black tracking-widest text-red-500 hover:text-red-400 transition no-underline flex items-center gap-1">
                                <i class="fas fa-flag"></i> Report
                            </a>
                        }
                    </div>
                    <!-- Clickable Owner Name -->
                    <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.OwnerId"
                       class="text-xl font-black text-white hover:text-blue-300 transition no-underline flex items-center gap-2 mb-2">
                        @Model.Owner?.Name <i class="fas fa-external-link-alt text-xs text-blue-400"></i>
                    </a>
                    <div class="flex flex-wrap gap-x-6 gap-y-1">
                        @if (!string.IsNullOrEmpty(Model.Owner?.PhoneNumber))
                        {
                            <p class="text-sm font-medium text-slate-300">
                                <i class="fas fa-phone-alt text-blue-400 text-xs mr-2"></i>@Model.Owner.PhoneNumber
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Owner?.Email))
                        {
                            <p class="text-sm font-medium text-slate-300">
                                <i class="fas fa-envelope text-blue-400 text-xs mr-2"></i>@Model.Owner.Email
                            </p>
                        }
                    </div>
                </div>
            </div>

            <!-- Location Box (Updated with coordinates) -->
            <div class="bg-white/10 border border-white/10 backdrop-blur-md rounded-2xl p-4 flex items-center gap-4 shadow-lg">
                <div class="bg-slate-800 p-3 rounded-xl text-2xl">📍</div>
                <div>
                    <p class="text-sm text-slate-400">Location</p>
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <a href="https://www.google.com/maps/search/?api=1&query=@Model.Latitude,@Model.Longitude"
                           target="_blank"
                           class="text-lg font-semibold text-white hover:text-blue-400 transition-colors no-underline">
                            @Model.Location?.City, @Model.Location?.Country <i class="fas fa-external-link-alt text-xs ml-1"></i>
                        </a>
                    }
                    else
                    {
                        <span class="text-lg font-semibold text-white">@Model.Location?.City, @Model.Location?.Country</span>
                    }
                </div>
            </div>
        </div>

        <!-- Image Gallery (Dynamic Slider) -->
        <div class="relative group rounded-[2.5rem] overflow-hidden shadow-2xl border border-white/10 bg-slate-800">
            @if (Model.Photos != null && Model.Photos.Any())
            {
                <div id="propertySlider" class="relative h-[600px] w-full">
                    @foreach (var photo in Model.Photos.Select((value, index) => new { value, index }))
                    {
                        <div class="slider-item absolute inset-0 transition-opacity duration-700 @(photo.index == 0 ? "opacity-100" : "opacity-0 pointer-events-none")" data-index="@photo.index">
                            <img src="@photo.value.PhotoUrl" class="w-full h-full object-cover" alt="Property Photo @photo.index" />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                        </div>
                    }

                    <!-- Navigation Controls -->
                    <button onclick="changeSlide(-1)" class="absolute left-6 top-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-black/20 backdrop-blur-md border border-white/20 flex items-center justify-center hover:bg-white hover:text-slate-950 transition-all z-40 opacity-0 group-hover:opacity-100">
                        <i class="fas fa-chevron-left text-xl"></i>
                    </button>
                    <button onclick="changeSlide(1)" class="absolute right-6 top-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-black/20 backdrop-blur-md border border-white/20 flex items-center justify-center hover:bg-white hover:text-slate-950 transition-all z-40 opacity-0 group-hover:opacity-100">
                        <i class="fas fa-chevron-right text-xl"></i>
                    </button>

                    <!-- Counter Badge -->
                    <div class="absolute bottom-8 right-8 px-4 py-2 bg-black/40 backdrop-blur-md rounded-full border border-white/20 text-[10px] font-black uppercase tracking-widest z-40">
                        <span id="currentIndex">1</span> / @Model.Photos.Count Photos
                    </div>
                </div>
            }
            else
            {
                <div class="h-[500px] flex items-center justify-center bg-slate-800">
                    <img src="/images/default.jpg" class="w-full h-full object-cover opacity-50" />
                    <p class="absolute text-slate-400 font-bold uppercase tracking-[0.2em]">No Photos Available</p>
                </div>
            }
        </div>

        <!-- Info & Booking Card -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left: Description -->
            <div class="lg:col-span-2 space-y-6">
                <div class="bg-white/5 border border-white/10 rounded-3xl p-8 shadow-xl">
                    <h3 class="text-xl font-bold mb-4 flex items-center gap-2">
                        <i class="fas fa-info-circle text-blue-400"></i> Description
                    </h3>
                    <p class="text-slate-300 leading-relaxed text-lg">@Model.Description</p>
                    
                    <div class="grid grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
                        <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                            <p class="text-slate-400 text-sm">Area</p>
                            <p class="text-2xl font-bold">📐 @Model.Area m²</p>
                        </div>
                        <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                            <p class="text-slate-400 text-sm">Bedrooms</p>
                            <p class="text-2xl font-bold">🛏 @Model.Rooms</p>
                        </div>
                        <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                            <p class="text-slate-400 text-sm">Bathrooms</p>
                            <p class="text-2xl font-bold">🛁 @Model.Bathrooms</p>
                        </div>
                    </div>
                </div>

                <!-- Features Section -->
                <div class="bg-white/5 border border-white/10 rounded-3xl p-8 shadow-xl">
                    <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                        <i class="fas fa-concierge-bell text-blue-400"></i> Property Features
                    </h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                        @if (Model.HasWifi)
                        {
                            <div class="flex items-center gap-3 text-slate-300">
                                <div class="w-10 h-10 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400">
                                    <i class="fas fa-wifi"></i>
                                </div>
                                <span class="font-medium">Wifi</span>
                            </div>
                        }
                        @if (Model.HasAC)
                        {
                            <div class="flex items-center gap-3 text-slate-300">
                                <div class="w-10 h-10 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400">
                                    <i class="fas fa-snowflake"></i>
                                </div>
                                <span class="font-medium">AC</span>
                            </div>
                        }
                        @if (Model.HasHeating)
                        {
                            <div class="flex items-center gap-3 text-slate-300">
                                <div class="w-10 h-10 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400">
                                    <i class="fas fa-fire"></i>
                                </div>
                                <span class="font-medium">Heating</span>
                            </div>
                        }
                        @if (Model.HasGym)
                        {
                            <div class="flex items-center gap-3 text-slate-300">
                                <div class="w-10 h-10 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400">
                                    <i class="fas fa-dumbbell"></i>
                                </div>
                                <span class="font-medium">Gym</span>
                            </div>
                        }
                        @if (Model.HasGarden)
                        {
                            <div class="flex items-center gap-3 text-slate-300">
                                <div class="w-10 h-10 bg-blue-500/10 rounded-xl flex items-center justify-center text-blue-400">
                                    <i class="fas fa-leaf"></i>
                                </div>
                                <span class="font-medium">Garden</span>
                            </div>
                        }
                        @if (!Model.HasWifi && !Model.HasAC && !Model.HasHeating && !Model.HasGym && !Model.HasGarden)
                        {
                            <p class="text-slate-500 italic col-span-full">No specific features listed.</p>
                        }
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="bg-white/5 border border-white/10 rounded-3xl p-8 shadow-xl">
                    <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                        <i class="fas fa-star text-yellow-400"></i> Reviews
                    </h3>
                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        <div class="space-y-6">
                            @foreach (var r in Model.Reviews)
                            {
                                <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                                    <div class="text-yellow-500 mb-2">
                                        @for (int i = 0; i < r.Rating; i++) { <span>★</span> }
                                    </div>
                                    <p class="text-slate-200">@r.Comment</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-500 italic">No reviews yet for this property.</p>
                    }
                </div>

                <!-- Add Review Section - hidden for Admin and Owner -->
                @if (user != null && !isOwner && !User.IsInRole("Admin") && !User.IsInRole("Owner"))
                {
                    <div class="bg-white/5 border border-white/10 rounded-3xl p-8 shadow-xl">
                        <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                            <i class="fas fa-edit text-blue-400"></i> Add Your Review
                        </h3>
                        <form asp-controller="Review" asp-action="Create" method="post" class="space-y-6">
                            <input type="hidden" name="PropertyId" value="@Model.PropertyId" />
                            
                            <div>
                                <label class="block text-slate-400 mb-2 text-sm">Rating</label>
                                <div class="rating flex flex-row-reverse justify-end gap-2 text-3xl">
                                    <input type="radio" name="Rating" value="5" id="r5" checked><label for="r5" class="cursor-pointer hover:text-yellow-400 transition">★</label>
                                    <input type="radio" name="Rating" value="4" id="r4"><label for="r4" class="cursor-pointer hover:text-yellow-400 transition">★</label>
                                    <input type="radio" name="Rating" value="3" id="r3"><label for="r3" class="cursor-pointer hover:text-yellow-400 transition">★</label>
                                    <input type="radio" name="Rating" value="2" id="r2"><label for="r2" class="cursor-pointer hover:text-yellow-400 transition">★</label>
                                    <input type="radio" name="Rating" value="1" id="r1"><label for="r1" class="cursor-pointer hover:text-yellow-400 transition">★</label>
                                </div>
                            </div>

                            <div>
                                <label class="block text-slate-400 mb-2 text-sm">Your Comment</label>
                                <textarea name="Comment" required 
                                          class="w-full p-4 rounded-2xl bg-slate-900 border border-slate-700 text-white focus:ring-2 focus:ring-blue-500 outline-none transition" 
                                          rows="4" placeholder="Share your experience with others..."></textarea>
                            </div>

                            <button type="submit" class="bg-blue-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-blue-700 transition shadow-lg">
                                Post My Review
                            </button>
                        </form>
                    </div>

                    <style>
                        .rating input { display: none; }
                        .rating input:checked ~ label { color: #facc15; }
                        .rating label { color: #475569; }
                    </style>
                }
            </div>

            <!-- Right: Booking Sidebar -->
            <div class="space-y-6">
                <div class="bg-white/5 border border-white/10 rounded-3xl p-8 shadow-xl sticky top-10">
                    <div class="mb-6">
                        <p class="text-slate-400 text-sm font-bold uppercase tracking-wider">Price per night</p>
                        <p class="text-4xl font-black text-white mt-1">$@Model.Price</p>
                    </div>

                    <div class="space-y-4">
                        @if (User.IsInRole("Admin"))
                        {
                            <!-- Admin read-only notice -->
                            <div class="p-5 bg-blue-500/10 text-blue-300 rounded-2xl text-center border border-blue-500/20">
                                <i class="fas fa-shield-alt text-2xl mb-2 block"></i>
                                <p class="font-bold text-sm">Admin View Only</p>
                                <p class="text-xs text-blue-400 mt-1">Admins cannot book or interact with properties.</p>
                            </div>
                        }
                        else if (user == null)
                        {
                            <div class="p-6 bg-white/5 rounded-2xl border border-white/5 text-center">
                                <p class="text-slate-300 mb-4 font-medium">Want to book this place?</p>
                                <a asp-controller="Users" asp-action="Login" 
                                   class="block w-full bg-blue-600 text-white py-3 rounded-xl font-bold hover:bg-blue-700 transition no-underline">
                                    Login to Book
                                </a>
                                <p class="text-xs text-slate-400 mt-3">Don't have an account? <a asp-controller="Users" asp-action="Register" class="text-blue-400 underline">Register</a></p>
                            </div>
                        }
                        else if (User.IsInRole("Owner") && !isOwner)
                        {
                            <!-- Owner read-only notice for other properties -->
                            <div class="p-5 bg-purple-500/10 text-purple-300 rounded-2xl text-center border border-purple-500/20">
                                <i class="fas fa-user-tie text-2xl mb-2 block"></i>
                                <p class="font-bold text-sm">Owner Account</p>
                                <p class="text-xs text-purple-400 mt-1">Owners cannot book properties. Please use a Customer account to book.</p>
                            </div>
                        }
                        else if (!isOwner && !User.IsInRole("Owner"))
                        {
                            <a asp-controller="Booking" asp-action="Create" asp-route-propertyId="@Model.PropertyId"
                               class="block text-center bg-blue-600 text-white py-4 rounded-2xl font-bold text-lg hover:bg-blue-700 transition shadow-xl no-underline transform hover:-translate-y-1 active:translate-y-0">
                                Book This Place
                            </a>
                        }
                        else
                        {
                            <div class="p-4 bg-blue-500/20 text-blue-300 rounded-2xl text-center font-bold border border-blue-500/20">
                                <i class="fas fa-user-shield mr-2"></i> You own this property
                            </div>
                            <a asp-action="Edit" asp-route-id="@Model.PropertyId"
                               class="block text-center bg-white text-slate-950 py-4 rounded-2xl font-bold hover:bg-slate-200 transition no-underline mt-4">
                                Edit Property
                            </a>
                        }
                    </div>

                    <div class="mt-6 pt-6 border-t border-white/10">
                        <p class="text-xs text-slate-500 text-center font-medium italic">
                            <i class="fas fa-shield-alt mr-1 text-blue-500"></i> Secure booking through Locamonda
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentSlide = 0;
        const slides = document.querySelectorAll('.slider-item');
        const currentIndexEl = document.getElementById('currentIndex');

        function changeSlide(direction) {
            if (!slides || !slides.length) return;

            // Hide current
            slides[currentSlide].classList.add('opacity-0', 'pointer-events-none');
            slides[currentSlide].classList.remove('opacity-100');

            // Calculate next
            currentSlide = (currentSlide + direction + slides.length) % slides.length;

            // Show next
            slides[currentSlide].classList.remove('opacity-0', 'pointer-events-none');
            slides[currentSlide].classList.add('opacity-100');

            // Update counter
            if (currentIndexEl) {
                currentIndexEl.textContent = currentSlide + 1;
            }
        }
    </script>
}
