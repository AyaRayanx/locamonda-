## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the TestResults folder
#TestResults/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.*

# ROSLYN TYPE SYSTEM CACHE
.allstar

# Code Analysis results
*.CodeAnalysisLog.xml
*.lastcodeanalysistypecache

# Guidance Extension output
*.sssql

# Local History for Visual Studio
.localhistory

# JetBrains Resharper temporary files
_ReSharper*/
*.[Rr]e[Ss][Hh]arper
*.DotSettings.user

# JustCode temporary files
.JustCode

# TeamCity build artifacts
_TeamCity*

# Omonat temporary files
.omonat

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# WebMatrix fields
_filenames
*.point

# Nodejs-specific files
node_modules/
npm-debug.log
package-lock.json

# Visual Studio Code config files
.vscode/

# Entity Framework Snapshot files
*.edmx.diagram
*.edmx.sqlce

# Local databases
*.mdf
*.ldf
*.sdf

# Cloud-based tools
.bundle/
.env
.powrc

# Misc
Thumbs.db
ehthumbs.db
Desktop.ini

# App Data
locamonda/wwwroot/uploads/*
!locamonda/wwwroot/uploads/.gitkeep
